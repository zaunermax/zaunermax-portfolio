{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": [
			"vite/client",
			"node"
		],
		"paths": {
			"@/*": [
				"./src/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"vitest.config.mts",
		"playwright.config.ts",
		"worker-configuration.d.ts",
		"tools/quest-voxel/review/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
